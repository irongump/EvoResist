"""
EvoResist Single-Lineage Pipeline
===================================
Run tree building and branch mutation analysis for a single lineage.

Given a lineage name the pipeline will:
  1. Auto-locate the corresponding strain list in strain_ids_dir
  2. Filter samples by depth (sample_flt.R)
  3. Generate concatenated FASTA alignment from pre-built CFA (create_cfa.py)
  4. Remove invariant/high-missing sites (del_invariant_customseq.pl)
  5. Build phylogenetic tree with IQ-TREE
  6. Extract per-branch mutations and annotate them

Usage:
  snakemake -s Snakefile_single_lineage --cores <N> \\
      --configfile config/config.yaml \\
      --config lineage=<lineage_name> [depth_thres=<N>]

  depth_thres is optional; it defaults to the value in config.yaml (30).
  Pass it on the command line to override without editing the config file.

Example:
  snakemake -s Snakefile_single_lineage --cores 4 \\
      --configfile config/config.yaml \\
      --config lineage=Lineage7_strain

Notes:
  - Pre-built CFA files must exist under data/old_cfa/ as
    {old_cfa_name}.fa and {old_cfa_name}_delete.pos.
    By default old_cfa_name matches the lineage name; override in config
    when they differ (e.g. lineage=Lineage7_strain, old_cfa_name=Lineage7).
  - output_dir must be a single-level directory name relative to the
    project root (e.g. "output", not "my/custom/output"); this is
    enforced at pipeline start.
"""

import os

configfile: "config/config.yaml"

LINEAGE    = config["lineage"]
OUTPUT_DIR = config.get("output_dir", "output")
if os.sep in OUTPUT_DIR or "/" in OUTPUT_DIR:
    raise ValueError(
        f"output_dir must be a single-level directory name (e.g. 'output'), "
        f"got: '{OUTPUT_DIR}'"
    )
DEPTH_THRES = config.get("depth_thres", 30)
# Base name used to locate files under data/old_cfa/; defaults to LINEAGE.
# Override in config if the old_cfa filename differs from the lineage name
# (e.g. lineage=Lineage7_strain but old_cfa files are named Lineage7.*).
OLD_CFA_NAME = config.get("old_cfa_name", LINEAGE)

# ---------------------------------------------------------------------------
# Auto-locate the strain list file for the requested lineage
# ---------------------------------------------------------------------------
STRAIN_FILE = os.path.join(config["strain_ids_dir"], f"{LINEAGE}.txt")
if not os.path.exists(STRAIN_FILE):
    raise ValueError(
        f"Strain file not found for lineage '{LINEAGE}': {STRAIN_FILE}"
    )

# Path where the depth-filtered strain list will be written
FLT_STRAIN_FILE = os.path.join(
    OUTPUT_DIR, "lineage_tree", f"{LINEAGE}_depth_{DEPTH_THRES}.txt"
)

# =============================================================================
# Final target
# =============================================================================
rule all:
    input:
        f"{OUTPUT_DIR}/lineage_ann/{LINEAGE}.ann",


# =============================================================================
# Step 1: Filter samples by depth
# =============================================================================
# Runs sample_flt.R, which writes the filtered strain list to the current
# working directory; the result is then moved to OUTPUT_DIR/lineage_tree/.

checkpoint filter_samples:
    input:
        strain_list=STRAIN_FILE,
    output:
        flt_strain=FLT_STRAIN_FILE,
    params:
        depth_file=config.get("depth_file", ""),
        depth_thres=DEPTH_THRES,
        out_dir=os.path.join(OUTPUT_DIR, "lineage_tree"),
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.out_dir}
        Rscript scripts/sample_flt.R \
            {input.strain_list} \
            {params.depth_file} \
            {params.depth_thres}
        flt_base="$(basename {input.strain_list} .txt)_depth_{params.depth_thres}.txt"
        mv "$flt_base" {output.flt_strain}
        """


# =============================================================================
# Step 2: Build Phylogenetic Tree
# =============================================================================
# Uses the filtered sample list to collect SNP positions, generate the
# concatenated FASTA alignment (snp2cfa.py), and build the tree with IQ-TREE.

rule build_tree:
    input:
        flt_strain=FLT_STRAIN_FILE,
        pos=f"data/old_cfa/{OLD_CFA_NAME}_delete.pos",
        ref=config["reference"],
    output:
        tree=f"{OUTPUT_DIR}/lineage_tree/{LINEAGE}_btp.treefile",
        state=f"{OUTPUT_DIR}/lineage_tree/{LINEAGE}_btp.state",
        new_pos=f"{OUTPUT_DIR}/lineage_tree/{LINEAGE}.pos",
    params:
        lineage=LINEAGE,
        tree_dir=f"{OUTPUT_DIR}/lineage_tree",
        temp_cfa=f"{OUTPUT_DIR}/lineage_tree/{LINEAGE}_tmp.fa",
        new_cfa=f"{OUTPUT_DIR}/lineage_tree/{LINEAGE}.fa",
        old_cfa=f"data/old_cfa/{OLD_CFA_NAME}.fa",
    threads: config["threads_tree"]
    resources:
        mem_mb=200000,
    shell:
        r"""
        set -euo pipefail
        lineage={params.lineage}
        tree_dir={params.tree_dir}
        mkdir -p "$tree_dir"

        # Build combined strain list: filtered strains + ancestor sequence "tb"
        combined_strain_file="${{tree_dir}}/${{lineage}}_combined_strains.txt"
        cp "{input.flt_strain}" "$combined_strain_file"
        echo "tb" >> "$combined_strain_file"

        # Extract sequences from old CFA for the selected strains
        python scripts/create_cfa.py "$combined_strain_file" "{params.old_cfa}" "{params.temp_cfa}"

        # Remove invariant and sites with >5% missing data
        perl scripts/del_invariant_customseq.pl "{params.temp_cfa}" "{input.pos}" "{params.new_cfa}" "{output.new_pos}"

        # Verify alignment was created
        if [ ! -f "{params.new_cfa}" ]; then
            echo "Error: Expected CFA file {params.new_cfa} not found!" >&2
            exit 1
        fi

        # Build tree with IQ-TREE (GTR+F+R4 model with bootstrap and SH-aLRT support)
        iqtree2 -s "{params.new_cfa}" \
            -m GTR+F+R4 \
            --seqtype DNA \
            --prefix "${{tree_dir}}/${{lineage}}_btp" \
            --mem {resources.mem_mb}M \
            -T {threads} \
            --ancestral \
            -o tb \
            -af fasta \
            -bb 1000 \
            -alrt 1000
        """


# =============================================================================
# Step 3: Branch Mutation Extraction
# =============================================================================

rule branch_mutations:
    input:
        tree=f"{OUTPUT_DIR}/lineage_tree/{LINEAGE}_btp.treefile",
        state=f"{OUTPUT_DIR}/lineage_tree/{LINEAGE}_btp.state",
        new_pos=f"{OUTPUT_DIR}/lineage_tree/{LINEAGE}.pos",
        low_ebr=config["low_ebr_file"],
        ref=config["reference"],
    output:
        ann=f"{OUTPUT_DIR}/lineage_ann/{LINEAGE}.ann",
    params:
        lineage=LINEAGE,
        tree_dir=f"{OUTPUT_DIR}/lineage_tree",
        ann_dir=f"{OUTPUT_DIR}/lineage_ann",
        cfa_dir=f"{OUTPUT_DIR}/lineage_cfa",
    threads: config["threads_annotation"]
    resources:
        mem_mb=20000,
    shell:
        r"""
        set -euo pipefail
        lineage={params.lineage}
        tree_dir={params.tree_dir}
        ann_dir={params.ann_dir}
        cfa_dir={params.cfa_dir}
        low_ebr={input.low_ebr}
        mkdir -p "$ann_dir"

        cd "$tree_dir"

        # Extract ancestral sequences for each node
        perl ../../scripts/nodes_base_locus_iqtree.pl \
            ${{lineage}}_btp.treefile \
            ${{lineage}}.pos \
            ${{lineage}}_btp.state \
            ${{lineage}}.fa \
            ${{lineage}}.db \
            ${{lineage}}_homoplasy.txt

        # Extract mutations from the database file
        perl ../../scripts/db2mutation.pl ${{lineage}}.db \
            > ${{lineage}}_db_mutation.txt

        # Annotate with leaf counts per node
        python ../../scripts/node_leafs.py \
            ${{lineage}}_btp.treefile \
            ${{lineage}}_db_mutation.txt \
            > ${{lineage}}_db_mutation2.txt

        # Remove ancestral (lineage-defining) mutations
        python ../../scripts/filter_lineage_defining.py \
            ${{lineage}}_db_mutation2.txt \
            ${{lineage}} \
            ../../{config[candidate_nodes_file]} \
            ../../{config[ancestor_db_mutation_file]} \
            ../../{config[lineage_ancestor_file]} \
            > ${{lineage}}_db_mutation2_rmanc.txt

        # Generate per-node SNP files
        python ../../scripts/getrefbase_per_node.py \
            ${{lineage}}_db_mutation2_rmanc.txt ${{lineage}} \
            ../../{input.ref}

        # Annotate each node's mutations in parallel
        find "${{lineage}}" -maxdepth 1 -name "*snp" -print0 | \
            parallel -0 -j {threads} '
                python ../../scripts/remove_low_ebr.py \
                    "../../'"$low_ebr"'" "{{}}" \
                    > "{{= s/\.snp$// =}}_rle.snp" &&
                perl ../../scripts/mtbc_translate/0_MTBC_Annotation_mtbc_4411532_corrected.pl \
                    "{{= s/\.snp$// =}}_rle.snp" \
                    > "{{= s/\.snp$// =}}.ann" &&
                sed -i "/^$/d" "{{= s/\.snp$// =}}.ann"
            '

        cat "${{lineage}}"/*.ann > "../../${{ann_dir}}/${{lineage}}.ann"

        # Clean up temporary files
        rm -f ${{lineage}}_db_mutation.txt ${{lineage}}_db_mutation2.txt
        rm -rf "${{lineage}}"

        cd ../..
        """
